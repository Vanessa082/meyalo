  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/ui": "~57.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.4",
