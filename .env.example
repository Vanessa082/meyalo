# Public client configuration. These values are embedded in the app.
# Copy to .env. Never commit .env. Never put a service-role key or a
# provider secret in an EXPO_PUBLIC_ variable.
# See docs/environment.md.

# Supabase project URL and the anon (public) key. The anon key is safe to ship;
# Row Level Security is what protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin for share links, event pages, and app links.
# No trailing path. Until a custom domain exists, use the Expo hosting origin,
# for example https://meyalo.expo.app
EXPO_PUBLIC_APP_BASE_URL=

# Optional. Required for Google Maps on Android and for Google Maps on iOS.
# Restrict the key to the app package / bundle id. Omit to use the platform
# default map provider where it works without a key (Apple Maps on iOS).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Required before store submission. https pages for the Privacy Policy and
# Terms. The welcome screen hides each link until its URL is set.
# The app serves both pages itself: <APP_BASE_URL>/privacy and <APP_BASE_URL>/terms
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# Optional. Venue search in the curator console. Unset uses the public
# OpenStreetMap Nominatim service (usage policy: one request per second,
# no search-as-you-type, attribution shown). Set to "off" to disable it, or to
# another https Nominatim origin.
# https://operations.osmfoundation.org/policies/nominatim/
EXPO_PUBLIC_GEOCODER_URL=

# Optional. "true" shows the Translate action on event pages. Set it only
# after the translate-event function has its provider key
# (GOOGLE_TRANSLATE_API_KEY, a server secret, never here). See
# docs/environment.md, "Translation".
EXPO_PUBLIC_TRANSLATION_ENABLED=
